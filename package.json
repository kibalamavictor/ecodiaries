{
  "name": "ecodiaries",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <=22"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "budget:check": "node scripts/check-bundle-budget.mjs",
    "build:perf": "npm run build && npm run budget:check",
    "vercel-build": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/vercel-prebuild.ts && npm run build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed.ts",
    "seed:test": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-test-content.ts",
    "seed:atlas": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-atlas.ts",
    "seed:qa": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-qa.ts",
    "seed:prod": "cross-env USE_NEON_DRIVER=true NEON_WEBSOCKET_ONLY=true NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-qa.ts",
    "seed:realistic": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-realistic-content.ts",
    "seed:realistic:prod": "cross-env USE_NEON_DRIVER=true NEON_WEBSOCKET_ONLY=true NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-realistic-content.ts",
    "seed:realistic:api": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-realistic-via-api.ts",
    "purge:seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/purge-seed-content.ts",
    "purge:prod": "cross-env USE_NEON_DRIVER=true NEON_WEBSOCKET_ONLY=true NODE_OPTIONS=--no-deprecation tsx src/scripts/purge-seed-content.ts",
    "purge:api": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/purge-via-api.ts",
    "qa:forms": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/qa-form-smoke.ts",
    "test:richtext": "cross-env NODE_OPTIONS=--no-deprecation tsx src/lib/cms/richtext.test.ts",
    "test:contributor-application": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/test-contributor-application.ts",
    "db:up": "docker start ecodiaries-db 2>/dev/null || docker compose up -d",
    "db:push": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/db-push.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "deploy:prod": "npm run typecheck && npm run build && vercel deploy --prod --yes"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@payloadcms/db-postgres": "3.85.1",
    "@payloadcms/next": "3.85.1",
    "@payloadcms/richtext-lexical": "^3.85.1",
    "@payloadcms/storage-s3": "3.85.1",
    "@payloadcms/storage-vercel-blob": "^3.85.1",
    "@payloadcms/ui": "3.85.1",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.5.0",
    "@vercel/og": "^0.11.1",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "framer-motion": "^12.40.0",
    "graphql": "^16.11.0",
    "lucide-react": "^1.21.0",
    "maplibre-gl": "^5.24.0",
    "next": "15.5.19",
    "payload": "3.85.1",
    "postcss": "^8.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^6.0.2",
    "react-hook-form": "^7.80.0",
    "react-map-gl": "^8.1.1",
    "recharts": "^3.8.1",
    "resend": "^4.5.1",
    "sharp": "0.34.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3.4",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@netlify/plugin-nextjs": "^5.15.12",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
